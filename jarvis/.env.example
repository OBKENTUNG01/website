# It's Me — contoh konfigurasi.
# Salin berkas ini menjadi .env lalu isi nilainya. JANGAN commit .env.

# --- Telegram ---------------------------------------------------------------
# Token bot dari @BotFather (kirim /newbot di Telegram).
TELEGRAM_BOT_TOKEN=

# User id Telegram KAMU. WAJIB diisi — hanya id ini yang boleh memerintah bot.
# Cara tahu: chat @userinfobot di Telegram. Setelah bot jalan, kirim /id ke
# bot untuk memastikan angkanya sama.
OWNER_TELEGRAM_ID=

# --- Pilihan otak -----------------------------------------------------------
# ollama (bawaan) = model lokal di komputermu lewat Ollama, gratis, tanpa key.
# openrouter      = model cloud lewat OpenRouter (jauh lebih pintar), butuh
#                   OPENROUTER_API_KEY. Otak lokal jadi cadangan otomatis.
# claude          = Claude lewat Anthropic API, butuh ANTHROPIC_API_KEY.
# Bisa juga diganti dari Telegram: /cloud, /lokal, /otak.
# ITSME_BACKEND=ollama

# --- Otak cloud lewat OpenRouter (opsional) ---------------------------------
# Paling gampang: jalankan lagi skrip setup dan tempel key saat diminta.
# Buat key di https://openrouter.ai/settings/keys dan ISI batas kredit (mis. $5)
# supaya aman kalau key bocor. Satu key sudah cukup untuk semua model.
# OPENROUTER_API_KEY=

# Model cloud (harus mendukung tools). Nama lengkap: https://openrouter.ai/models
#   google/gemma-4-31b-it:free   gratis, maks. 50 permintaan/hari
#   anthropic/claude-haiku-5.5   murah & andal (sekitar $0,001 per pesan)
#   anthropic/claude-sonnet-5.5  paling pintar, lebih mahal
# ITSME_OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Model cadangan (dipisah koma) yang langsung dicoba OpenRouter kalau model
# utama sedang penuh. Bawaan untuk model ":free": openrouter/free, yang memilih
# model gratis lain yang mendukung alat. Isi off untuk mematikan.
# ITSME_OPENROUTER_FALLBACKS=openrouter/free

# Seberapa keras model cloud berpikir: none | low | medium | high | max | default
# ITSME_OPENROUTER_REASONING=medium

# Kalau otak cloud gagal (saldo habis, batas harian, internet), otak lokal
# otomatis menjawab. Isi 0 untuk mematikan.
# ITSME_FALLBACK_LOCAL=1

# --- Otak lokal (Ollama) ----------------------------------------------------
# Alamat Ollama di komputer ini (bawaan sudah benar kalau Ollama di komputer
# yang sama).
# OLLAMA_URL=http://localhost:11434

# Model yang dipakai. Unduh dulu dengan: ollama pull <nama-model>
#   qwen3.5:9b  bawaan — paling pintar yang muat di RAM 16 GB (unduhan 6,6 GB)
#   qwen3.5:4b  lebih ringan & cepat untuk komputer yang lambat (3,3 GB)
#   qwen3:8b    alternatif yang paling teruji untuk pemanggilan alat (5,2 GB)
# ITSME_OLLAMA_MODEL=qwen3.5:9b

# Panjang konteks (token). Naikkan kalau RAM lega, turunkan kalau kehabisan RAM.
# ITSME_OLLAMA_NUM_CTX=16384

# Berapa lama model tetap di RAM setelah dipakai: 30m, 2h, atau -1 (selamanya).
# ITSME_OLLAMA_KEEP_ALIVE=30m

# Mode berpikir: false (bawaan), true, atau default (ikuti model).
# true = lebih teliti tapi bisa bermenit-menit per jawaban di komputer tanpa GPU.
# ITSME_OLLAMA_THINK=false

# Wilayah pencarian web (negara-bahasa): id-id (bawaan) atau us-en.
# ITSME_SEARCH_REGION=id-id

# Batas waktu satu jawaban model, dalam detik.
# ITSME_OLLAMA_TIMEOUT=600

# --- Otak Claude (hanya kalau ITSME_BACKEND=claude) -------------------------
# API key dari https://platform.claude.com (paket Max/Team dapat kredit
# API bulanan — lihat README).
# ANTHROPIC_API_KEY=
# ITSME_MODEL=claude-opus-5-5
# ITSME_EFFORT=max
# ITSME_MAX_TOKENS=64000

# --- Website (edit lewat Git) ----------------------------------------------
# Folder clone lokal dari repo website yang mau diedit It's Me.
# Contoh Windows: C:\Users\nama\website   Linux/Mac: /home/nama/website
# WEBSITE_REPO_DIR=
