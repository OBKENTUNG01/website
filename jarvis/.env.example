# It's Me — contoh konfigurasi.
# Salin berkas ini menjadi .env lalu isi nilainya. JANGAN commit .env.

# --- Telegram ---------------------------------------------------------------
# Token bot dari @BotFather (kirim /newbot di Telegram).
TELEGRAM_BOT_TOKEN=

# User id Telegram KAMU. WAJIB diisi — hanya id ini yang boleh memerintah bot.
# Cara tahu: chat @userinfobot di Telegram. Setelah bot jalan, kirim /id ke
# bot untuk memastikan angkanya sama.
OWNER_TELEGRAM_ID=

# Lapisan kedua (opsional): kata sandi yang harus dimasukkan sebelum memakai bot,
# walau pengirimnya sudah pemilik. Jawaban yang salah SELALU dibalas "kata sandi
# minimal 20 karakter" sebagai pengecoh — padahal kata sandi aslimu boleh pendek,
# jadi orang yang coba-coba menebak panjang yang salah. Kosong = mati. /lock untuk
# mengunci lagi. Isi ITSME_LOCK_TTL (menit) untuk mengunci otomatis setelah diam.
# ITSME_PASSPHRASE=
# ITSME_LOCK_TTL=0

# --- Pilihan otak -----------------------------------------------------------
# ollama (bawaan) = model lokal di komputermu lewat Ollama, gratis, tanpa key.
# openrouter      = model cloud lewat OpenRouter (jauh lebih pintar), butuh
#                   OPENROUTER_API_KEY. Otak lokal jadi cadangan otomatis.
# deepseek        = model DeepSeek (murah & pintar), butuh DEEPSEEK_API_KEY.
#                   Otak lokal jadi cadangan otomatis.
# claude          = Claude lewat Anthropic API, butuh ANTHROPIC_API_KEY.
# claude_code     = Claude di komputer dengan akun Claude-mu (tanpa API key),
#                   butuh CLAUDE_CODE_OAUTH_TOKEN (lihat bagian di bawah).
# Bisa juga diganti dari Telegram: /cloud, /deepseek, /claudepc, /claude, /lokal, /otak.
# ITSME_BACKEND=ollama

# --- Otak cloud lewat OpenRouter (opsional) ---------------------------------
# Paling gampang: jalankan lagi skrip setup dan tempel key saat diminta.
# Buat key di https://openrouter.ai/settings/keys dan ISI batas kredit (mis. $5)
# supaya aman kalau key bocor. Satu key sudah cukup untuk semua model.
# OPENROUTER_API_KEY=

# Model cloud (harus mendukung tools). Nama lengkap: https://openrouter.ai/models
#   google/gemma-4-31b-it:free   gratis, maks. 50 permintaan/hari
#   anthropic/claude-haiku-5.5   murah & andal (sekitar $0,001 per pesan)
#   anthropic/claude-sonnet-5.5  paling pintar, lebih mahal
# ITSME_OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Model cadangan (dipisah koma) yang langsung dicoba OpenRouter kalau model
# utama sedang penuh. Bawaan untuk model ":free": openrouter/free, yang memilih
# model gratis lain yang mendukung alat. Isi off untuk mematikan.
# ITSME_OPENROUTER_FALLBACKS=openrouter/free

# Seberapa keras model cloud berpikir: none | low | medium | high | max | default
# ITSME_OPENROUTER_REASONING=medium

# Kalau otak cloud gagal (saldo habis, batas harian, internet), otak lokal
# otomatis menjawab. Isi 0 untuk mematikan.
# ITSME_FALLBACK_LOCAL=1

# --- Otak DeepSeek (opsional, kompatibel OpenAI) ----------------------------
# Murah & pintar. Paling gampang dari Telegram: /deepseek <key>  (key langsung
# diperiksa, disimpan, dan dipakai; pesannya dihapus). Atau isi di sini:
# DEEPSEEK_API_KEY=
# Alamat API kompatibel OpenAI. Bawaan DeepSeek resmi. GANTI kalau key-mu dari
# gateway lain (mis. key diawali nsk-): isi alamat gateway itu.
# DEEPSEEK_URL=https://api.deepseek.com/v1
# Model. deepseek-chat (bawaan) mendukung alat; deepseek-reasoner tidak.
# ITSME_DEEPSEEK_MODEL=deepseek-chat
# ITSME_DEEPSEEK_TIMEOUT=300

# --- Otak lokal (Ollama) ----------------------------------------------------
# Alamat Ollama di komputer ini (bawaan sudah benar kalau Ollama di komputer
# yang sama).
# OLLAMA_URL=http://localhost:11434

# Model yang dipakai. Unduh dulu dengan: ollama pull <nama-model>
#   qwen3.5:9b  bawaan — paling pintar yang muat di RAM 16 GB (unduhan 6,6 GB)
#   qwen3.5:4b  lebih ringan & cepat untuk komputer yang lambat (3,3 GB)
#   qwen3:8b    alternatif yang paling teruji untuk pemanggilan alat (5,2 GB)
# ITSME_OLLAMA_MODEL=qwen3.5:9b

# Panjang konteks (token). Naikkan kalau RAM lega, turunkan kalau kehabisan RAM.
# ITSME_OLLAMA_NUM_CTX=16384

# Lapisan model yang ditaruh di GPU. Kosong = otomatis. 0 = CPU saja (lebih
# lambat, tapi berguna kalau driver GPU membuat Ollama berhenti mendadak —
# mis. kartu grafis lama seperti GeForce GT 6xx/7xx). It's Me juga mendeteksi
# crash GPU sendiri dan mengingat pengaturan aman di data/ollama_state.json.
# ITSME_OLLAMA_NUM_GPU=

# Berapa lama model tetap di RAM setelah dipakai: 30m, 2h, atau -1 (selamanya).
# ITSME_OLLAMA_KEEP_ALIVE=30m

# Mode berpikir: false (bawaan), true, atau default (ikuti model).
# true = lebih teliti tapi bisa bermenit-menit per jawaban di komputer tanpa GPU.
# ITSME_OLLAMA_THINK=false

# Wilayah pencarian web (negara-bahasa): id-id (bawaan) atau us-en.
# ITSME_SEARCH_REGION=id-id

# Batas waktu satu jawaban model, dalam detik.
# ITSME_OLLAMA_TIMEOUT=600

# --- Otak Claude (hanya kalau ITSME_BACKEND=claude) -------------------------
# API key dari https://platform.claude.com (paket Max/Team dapat kredit
# API bulanan — lihat README).
# ANTHROPIC_API_KEY=
# ITSME_MODEL=claude-opus-5-5
# low | medium (bawaan) | high | xhigh | max — makin tinggi makin teliti & mahal.
# ITSME_EFFORT=medium
# ITSME_MAX_TOKENS=64000

# --- Claude di komputer dengan akun Claude-mu (/claudepc) --------------------
# Tanpa API key. Paling gampang: jalankan di komputer
#   .venv\Scripts\python -m itsme.claude_login
# yang membuka browser untuk login lalu mengisi token ini (berlaku ±1 tahun).
# CLAUDE_CODE_OAUTH_TOKEN=
# Kosong = model bawaan akunmu. Bisa: sonnet, opus, haiku.
# ITSME_CLAUDE_CODE_MODEL=
# Batas langkah per pesan; 0 = tanpa batas (bawaan).
# ITSME_CLAUDE_CODE_MAX_TURNS=0

# --- It's Me Node: banyak komputer tanpa hub ----------------------------------
# Kalau It's Me Node terpasang, bot Telegram hanya aktif di komputer pemimpin;
# komputer lain siaga dan mengambil alih kalau pemimpin mati. 0 = abaikan node.
# ITSME_FOLLOW_NODE=1
# ITSME_NODE_URL=http://127.0.0.1:7171

# --- Dashboard web (nomor 4) -------------------------------------------------
# Halaman web untuk melihat status & mengatur It's Me (ganti otak, akses,
# memori, log). Buka http://localhost:8750 di komputer. Isi 0 untuk mematikan.
# ITSME_DASHBOARD=1
# 127.0.0.1 (bawaan) = hanya dari komputer ini. 0.0.0.0 = bisa dari HP di WiFi
# yang sama (saat itu wajib token; token ada di data/dashboard_token.txt dan
# ditampilkan di log saat It's Me menyala — buka ...?token=ISI sekali).
# ITSME_DASHBOARD_HOST=127.0.0.1
# ITSME_DASHBOARD_PORT=8750
# Login dashboard. Kalau ITSME_DASHBOARD_PASSWORD diisi, dashboard minta login
# user+password (disarankan kalau dibuka dari HP/internet lewat Tailscale atau
# Cloudflare Tunnel). Lihat PANDUAN_AKSES_JARAK_JAUH.md.
# ITSME_DASHBOARD_USER=admin
# ITSME_DASHBOARD_PASSWORD=
#
# Membuka dashboard lewat DOMAIN SENDIRI (mis. domainku.com) sebagai jembatan,
# tanpa Tailscale — pakai Cloudflare Tunnel (lihat PANDUAN_AKSES_JARAK_JAUH.md).
# Nyalakan mode publik: wajib login, anti tebak-password, header keamanan ketat,
# dan tidak ada jalan pintas localhost (penting karena tunnel masuk lewat localhost).
# ITSME_DASHBOARD_PUBLIC=1
# Login pakai BERKAS KUNCI yang tetap (tidak berubah): unggah berkas
# data/dashboard.key (dibuat otomatis, salin ke HP-mu) untuk masuk. Otomatis
# aktif saat ITSME_DASHBOARD_PUBLIC=1; bisa juga dinyalakan sendiri:
# ITSME_DASHBOARD_KEY_LOGIN=1
# Batasi domain yang boleh (Host), dipisah koma. KOSONG = bebas ganti domain
# sesukamu (keamanan tetap dari berkas kunci, bukan dari nama domain).
# ITSME_DASHBOARD_DOMAINS=
# Percayai IP asli dari tunnel (Cloudflare) untuk anti brute-force. 0 kalau tanpa proxy.
# ITSME_DASHBOARD_TRUST_PROXY=1

# --- Banyak komputer, satu bot (Hub + Perangkat) -----------------------------
# Komputer utama (Hub) memakai token Telegram seperti biasa. Komputer lain
# (Perangkat) TIDAK memakai token: isi ITSME_HUB_URL dengan alamat dashboard Hub
# (mis. http://100.x.y.z:8750 lewat Tailscale; dashboard Hub harus bisa
# dijangkau: ITSME_DASHBOARD_HOST=0.0.0.0 atau IP Tailscale-nya). Lalu di
# Telegram: /perangkat untuk daftar, /pakai <nama> untuk menyuruh komputer itu.
# Memori, otak, dan mode akses Hub otomatis disalin ke semua perangkat.
# ITSME_HUB_SECRET wajib SAMA PERSIS di Hub dan semua perangkat (buat acak,
# mis. 32 huruf/angka); tanpa ini Hub menolak perangkat.
# ITSME_HUB_SECRET=
# Hanya di PERANGKAT (kosongkan di Hub):
# ITSME_HUB_URL=
# ITSME_DEVICE_NAME=Laptop

# --- Website (edit lewat Git) ----------------------------------------------
# Folder clone lokal dari repo website yang mau diedit It's Me.
# Contoh Windows: C:\Users\nama\website   Linux/Mac: /home/nama/website
# WEBSITE_REPO_DIR=

# --- Pembaruan otomatis dari GitHub -------------------------------------------
# It's Me memeriksa repo GitHub-nya berkala. Kalau ada commit baru, kodenya
# dipasang (.env & memori tetap) lalu It's Me menyala ulang sendiri dan
# mengabarimu di Telegram. Isi 0 untuk mematikan.
# ITSME_AUTO_UPDATE=1
# Jeda antar pemeriksaan, dalam detik (minimal 60).
# ITSME_UPDATE_INTERVAL=120
# Repo & cabang yang diikuti.
# ITSME_UPDATE_REPO=OBKENTUNG01/website
# ITSME_UPDATE_BRANCH=main
