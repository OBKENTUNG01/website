# It's Me — contoh konfigurasi.
# Salin berkas ini menjadi .env lalu isi nilainya. JANGAN commit .env.

# --- Telegram ---------------------------------------------------------------
# Token bot dari @BotFather (kirim /newbot di Telegram).
TELEGRAM_BOT_TOKEN=

# User id Telegram KAMU. WAJIB diisi — hanya id ini yang boleh memerintah bot.
# Cara tahu: jalankan bot, kirim /id ke bot, atau chat @userinfobot.
OWNER_TELEGRAM_ID=

# --- Otak (Anthropic) -------------------------------------------------------
# API key dari https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model & tingkat upaya. Default sudah sesuai permintaan: Opus 5.5, effort max.
# Effort yang valid: low | medium | high | xhigh | max.
# ITSME_MODEL=claude-opus-5-5
# ITSME_EFFORT=max
# ITSME_MAX_TOKENS=16000

# --- Website (edit lewat Git) ----------------------------------------------
# Folder clone lokal dari repo website yang mau diedit It's Me.
# Contoh: /home/user/website  atau  /data/data/com.termux/files/home/website
# WEBSITE_REPO_DIR=
